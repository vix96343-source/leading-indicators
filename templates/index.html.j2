<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>{{ title }}</title>
<style>
{% include "_board.css" %}
</style>
</head>
<body>
<div class="wrap">
  <div class="top">
    <h1>{{ title }}</h1>
    <span class="meta">更新 {{ generated_at }}{% if public %} ／ 公開版{% endif %}</span>
    <span class="spacer"></span>
    <button class="theme-btn" id="themeBtn" type="button" aria-label="表示テーマ切替">◐</button>
  </div>
  <p class="summary">追い風<b class="up">{{ tally.up }}</b> 逆風<b class="down">{{ tally.down }}</b> 横ばい・中立<b>{{ tally.flat }}</b></p>

  <div class="scroll">
    <table>
      <thead>
        <tr><th class="l">指標</th><th>日付</th><th>最新値</th><th colspan="3">変化</th><th>判定</th></tr>
      </thead>
      <tbody>
      {% for g in groups %}
        <tr class="g"><td colspan="7" title="{{ g.note }}">{{ g.name }}</td></tr>
        {% for r in g.rows %}
        {% if loop.first or r.kind != loop.previtem.kind or r.section != loop.previtem.section %}
        <tr class="h"><td class="l">{{ r.section or '' }}</td><td></td><td></td>{% for label in columns[r.kind] %}<td>{{ label }}</td>{% endfor %}<td></td></tr>
        {% endif %}
        <tr class="s">
          <td class="l name" title="{{ r.lead }}"><a href="{{ r.source_url }}" target="_blank" rel="noopener">{{ r.name }}</a></td>
          <td class="date">{{ r.date }}{% if r.stale %}<span class="stale-mark" title="更新が止まっている可能性">*</span>{% endif %}</td>
          <td>{{ r.value }}<span class="unit"> {{ r.unit }}</span></td>
          {% for c in r.cols %}<td class="{{ c.cls }}">{{ c.value }}</td>{% endfor %}
          <td class="{{ r.judge_cls }}">{{ r.judge }}</td>
        </tr>
        {% endfor %}
      {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="note">
    日次は3か月の変化、月次は前年比が3か月前より2pt以上上がれば「加速」で判定。判定は関連銘柄にとっての追い風を赤、逆風を青で表示。
    加速 = 前年比 − 3か月前の前年比（pt）。日付の * は更新が止まっている可能性。指標名から出所へ（長押し・カーソルで関連銘柄のメモ）。
  </p>


  <footer>
    <table>
      <tbody>
      {% for s in status %}
      <tr><td>{{ s.name }}</td><td class="{{ 'ok' if s.ok else 'ng' }}">{{ '正常' if s.ok else '失敗' }}</td><td>{{ s.at }}</td><td>{{ s.message }}</td></tr>
      {% endfor %}
      </tbody>
    </table>
    <p>各データの権利は出所の各機関に帰属します。個人の調査用で、投資判断を推奨するものではありません。</p>
  </footer>
</div>
<script>
(function () {
  var root = document.documentElement, btn = document.getElementById('themeBtn');
  try { var t = localStorage.getItem('boardTheme'); if (t) root.setAttribute('data-theme', t); } catch (e) {}
  btn.addEventListener('click', function () {
    var next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('boardTheme', next); } catch (e) {}
  });
})();
</script>
</body>
</html>
